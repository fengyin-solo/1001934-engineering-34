# 本地开发模式（vite / npm run dev）取数口径：
# VITE_API_BASE 留空，页面走 vite.config.ts 里的 /api 代理转发到后端；
# 需要临时换后端地址时，用 .env.development.local 覆盖（该文件不入库），不要改本文件。
VITE_API_BASE=
VITE_APP_NAME=风电场机组运维平台
# 后端代理目标，默认值写在 vite.config.ts，这里保持一致便于一处看清。
VITE_PROXY_TARGET=http://127.0.0.1:8000
# 本地开发服务器端口。
VITE_DEV_PORT=5173
